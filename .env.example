# Copy to .env and fill in. Never commit .env.
# ---- Shared: bot, pipeline and MCP server ----
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/

# ---- MCP server (brain/) ----
MONGO_DB=News
# cloud (Render, Claude/ChatGPT: public + internal only) | local (own machine)
TRUST_LEVEL=cloud
# Local development without OAuth: act as this users._id (Telegram id). Refused on a public URL.
# Never set it on Render.
DEV_USER_ID=
MAX_SENSITIVITY_LOCAL=restricted
# Render: https://YOUR-SERVICE.onrender.com
PUBLIC_BASE_URL=http://127.0.0.1:8000
# JSON list, e.g. ["your-service.onrender.com"]
ALLOWED_HOSTS=[]
# ---- OAuth with Auth0 (docs/CONNECT_CLAUDE.md) ----
# Exactly as in the token's iss claim, with the trailing slash
OAUTH_ISSUER=https://YOUR-TENANT.eu.auth0.com/
# The Auth0 API identifier; defaults to PUBLIC_BASE_URL + /mcp
OAUTH_AUDIENCE=
OAUTH_REQUIRED_SCOPES=[]
OAUTH_CLAIMS_NAMESPACE=https://news-brain/
# A first sign-in creates a new users record (Telegram users are not touched)
AUTO_CREATE_USERS=true
# JSON list; empty = anyone who can sign in to the Auth0 tenant
ALLOWED_EMAILS=["you@example.com"]
# Behind Render's proxy (the only route to the service)
FORWARDED_ALLOW_IPS=*
# local (teammate's model via the adapter) | anthropic (temporary fallback, public/internal data only)
MODEL_BACKEND=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AUDIT_TTL_DAYS=180
# Automatic learning in the MCP service (docs/LEARNING_PLAN.md). Needs ANTHROPIC_API_KEY with the anthropic backend
LEARNING_AUTO=false
LEARNING_BACKEND=anthropic
LEARNING_FEEDBACK_THRESHOLD=20
LEARNING_GOAL_DELAY_MINUTES=2
LEARNING_COOLDOWN_MINUTES=30
LEARNING_MAX_RUNS_PER_DAY=20
# The learner's model (a profile merge doesn't need the largest one)
LEARNING_MODEL=claude-sonnet-5-5
# All agents' backend and model unless an agent has its own (brain/agents/common.py)
AGENT_BACKEND=
AGENT_MODEL=
# Agents (docs/AGENT_PLAN.md): tokens per user per day for each agent
AGENT_USER_TOKENS_PER_DAY=300000
# The scout (docs/AGENT_PLAN.md phase 2): rising names in our posts, proposed to users they fit. Backend / model
# default to the learning job's; a smaller model is enough here
SCOUT_AUTO=false
SCOUT_EVERY_HOURS=6
SCOUT_BACKEND=anthropic
SCOUT_MODEL=claude-haiku-5-5
# The web scout (phase 3): searches the web around users' goals and interests (anthropic only; $10 per 1,000
# searches plus tokens). At most 5 searches per area, SCOUT_WEB_AREAS areas, SCOUT_WEB_SEARCHES_PER_DAY in all
SCOUT_WEB=false
SCOUT_WEB_EVERY_HOURS=24
SCOUT_WEB_SEARCHES_PER_DAY=40
SCOUT_WEB_AREAS=8
# The advisor (phase 4): once a day, what changed for each user and one next step (model: ADVISOR_MODEL, else
# SCOUT_MODEL; one small call per user, only when a topic or goal had news)
ADVISOR_AUTO=false
ADVISOR_EVERY_HOURS=24
# Conversation log (conversations): a new document after this idle time, or at this many messages
CONVERSATION_IDLE_MINUTES=30
CONVERSATION_MAX_MESSAGES=500
LOG_LEVEL=INFO

# ---- The web app (brain/web, docs/WEB_PLAN.md): its own Render service, same MONGO_URI / MONGO_DB ----
# On that service PUBLIC_BASE_URL is the web app's URL, and OAUTH_ISSUER the same tenant as above.
# Auth0 → Applications → Regular Web Application: callback PUBLIC_BASE_URL/auth/callback, logout PUBLIC_BASE_URL/
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
# python -c "import secrets; print(secrets.token_urlsafe(48))"
WEB_SESSION_SECRET=
WEB_SESSION_DAYS=14
# Default: data-digest-web/frontend in the repo
WEB_FRONTEND_DIR=
# The chat (Аналітик): Claude with the brain's tools; needs ANTHROPIC_API_KEY on this service. Each round is in
# audit_log (model_call); a user's tokens per UTC day are capped.
WEB_CHAT_MODEL=claude-sonnet-5-5
WEB_CHAT_TOKENS_PER_DAY=500000
WEB_CHAT_MAX_ROUNDS=8
WEB_CHAT_HISTORY=30
WEB_CHAT_WEB_SEARCH=true
# web_research: the searches run with this model; the chat reads its short brief, not the pages
WEB_CHAT_RESEARCH_MODEL=claude-haiku-5-5

# ---- Tests ----
# Throwaway databases News_test_<random> are created here and dropped afterwards (defaults to MONGO_URI)
TEST_MONGO_URI=
# Read-only contract check on real data: pytest tests/contract -m contract
CONTRACT_MONGO_URI=
