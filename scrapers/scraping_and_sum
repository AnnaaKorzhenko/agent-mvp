def remove_emojis(text: str) -> str:
   
    if not text:
        return ""
    return emoji.replace_emoji(text, replace="")

def clean_post_text(text: str) -> str:
    if not text:
        return ""


    text = remove_emojis(text)
    lines = [line.strip() for line in text.split('\n')]
    

    footer_phrases = [
        "блог", "Написати нам", "Підтримати нас", 
        "мапа", "написати", "підтримати", "повідомити", "реклама", "адмін"
    ]
    
   
    while lines:
        last_line = lines[-1]
        clean_line_chars = ''.join(c for c in last_line if c.isalnum()).lower()
        
        is_empty = not last_line
        is_symbol_only = not clean_line_chars  
        is_footer = any(phrase in last_line.lower() for phrase in footer_phrases)
        
        if is_empty or is_symbol_only or is_footer:
            lines.pop()
        else:
            break
    

    lines = [line for line in lines if line]

   
    cleaned_text = '\n\n'.join(lines)


    cleaned_text = re.sub(r'[ \t]+', ' ', cleaned_text).strip()
    cleaned_text = re.sub(r'\s+', ' ', text).strip()

    return cleaned_text



def scrape_tg_web_channel(channel_username: str) -> list[dict]:
    clean_username = channel_username.replace("@", "")
    url = f"https://t.me/s/{clean_username}"
    headers = {
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }

    try:
        response = requests.get(url, headers=headers, timeout=15)
        if response.status_code != 200:
            logger.error(f"Failed to fetch Telegram channel {channel_username}: HTTP {response.status_code}")
            return []

        soup = BeautifulSoup(response.text, "html.parser")
        messages = soup.find_all("div", class_="tgme_widget_message")
        extracted_posts = []

        for msg in messages:
            text_node = msg.find("div", class_="tgme_widget_message_text")
            date_node = msg.find("time", class_="datetime")
            link_node = msg.find("a", class_="tgme_widget_message_date")

            if not text_node or not link_node:
                continue

            raw_text = text_node.get_text(separator="\n", strip=True)
            
            if "#реклама" in raw_text.lower():
                continue

            post_text = clean_post_text(raw_text)

            if not post_text:  
                continue


            post_url = link_node.get("href", "")
            post_id = post_url.split("/")[-1] if post_url else ""
            pub_date_str = date_node.get("datetime", "") if date_node else datetime.utcnow().isoformat()

            extracted_posts.append({
                "post_id": post_id,
                "post_url": post_url,
                "raw_text": post_text,
                "summary": None,
                "category": None,  
                "cross_border_focus": None, 
                "published_at": pub_date_str,
                "processed": False,
                "created_at": datetime.utcnow().isoformat()
            })

        return extracted_posts

    except Exception as e:
        logger.error(f"Error scraping Telegram web channel {channel_username}: {e}")
        return []

async def run_tg_scraper():
  
    channels_cursor = sources_collection.find({"platform": "telegram"})
    channels = await channels_cursor.to_list(length=None)
    
    if not channels:
        logger.warning("У колекції 'sources' не знайдено жодного Telegram-каналу!")
        return

    
   
    for channel in channels:
        channel_id = channel["_id"]  
        formatted_username = channel.get("username", "")
        channel_country = channel.get("source_country", "Unknown")

        if not formatted_username:
            continue

       
        posts = scrape_tg_web_channel(formatted_username)
        saved_count = 0

        for post in posts:
            post_data = {
                "channel_id": channel_id,  
                **post
            }

            post_data.pop("source_channel", None)


            result = await posts_collection.update_one(
                {"post_url": post_data["post_url"]},
                {
                    "$setOnInsert": post_data
                },
                upsert=True
            )
            
            if result.upserted_id:
                saved_count += 1

                preview_text = post_data["raw_text"].replace("\n", " ")[:80]
                logger.info(f"   ({formatted_username}): {preview_text}...")

        logger.info(f"Channel {formatted_username} ({channel_country}): Знайдено постів: {len(posts)}, оновлено/збережено в 'raw_posts': {saved_count}.\n")
        
        await asyncio.sleep(random.randint(2, 5))

async def generate_missing_summaries(batch_size=4):
   
    MODEL_NAME = "csebuetnlp/mT5_multilingual_XLSum"
    tokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)
    model = AutoModelForSeq2SeqLM.from_pretrained(MODEL_NAME)

    device = "cuda" if torch.cuda.is_available() else "cpu"
    model.to(device).eval()
   
 
    cursor = posts_collection.find({"$or": [{"summary": None}, {"summary": {"$exists": False}}]})
    posts_to_summarize = await cursor.to_list(length=None)

    if not posts_to_summarize:
        logger.info("Усі пости вже мають самарі")
        return

    logger.info(f"Знайдено постів без самарі для обробки: {len(posts_to_summarize)}")

    for i in range(0, len(posts_to_summarize), batch_size):
        batch = posts_to_summarize[i:i + batch_size]
        texts = [p["raw_text"] for p in batch]
        
  
        cleaned_texts = [re.sub(r"\s+", " ", t.strip()) for t in texts]
        inputs = tokenizer(
            cleaned_texts, 
            return_tensors="pt", 
            padding=True,
            truncation=True, 
            max_length=512
        ).to(device)
        
        with torch.no_grad():
            out = model.generate(
                **inputs, 
                max_new_tokens=84,
                num_beams=4, 
                no_repeat_ngram_size=2
            )
            
        summaries = tokenizer.batch_decode(out, skip_special_tokens=True)

       
        for post, summary_text in zip(batch, summaries):
            final_summary = summary_text.strip()
            await posts_collection.update_one(
                {"_id": post["_id"]},
                {"$set": {"summary": final_summary}}
            )
      



await run_tg_scraper()
await generate_missing_summaries()
